# Copy this file to .env and fill in real values before deploying.
# Never commit .env to version control.

# !! IMPORTANT !! Generate a strong random key before production:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Then replace the placeholder below with the output.
SECRET_KEY=replace-with-a-random-64-char-string

# Anthropic API key for invoice photo scanning (AI auto-fill in inventory)
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Set to "true" in production (HTTPS). Leave "false" for local HTTP development.
SESSION_COOKIE_SECURE=true

# Public URL for shareable bill links (e.g. your PythonAnywhere or Cloudflare tunnel URL)
# Leave unset for local development — bill links will use the browser's current origin.
# Example: https://shubhamnxtailoring.pythonanywhere.com
SHARE_BASE_URL=

# Web address of the Mirror Try-On tablet app. Shown as "Mirror Try-On" in the
# menu and opens in a new tab. Defaults to https://shubham-nx-tryon.vercel.app
# when unset; set to an empty value (TRYON_URL=) to hide the menu item.
# TRYON_URL=https://shubham-nx-tryon.vercel.app

# Cloudflare R2 storage for tailoring photos (cloth samples + measurements).
# Optional: leave all four blank to keep saving photos on local disk exactly
# as before. Set all four to offload new photo uploads to R2 instead (frees
# up server disk space — see the R2 setup steps in PROJECT.md).
#   R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY come from
#   Cloudflare dashboard -> R2 -> Manage API Tokens -> Create API Token.
#   R2_BUCKET_NAME is the bucket you create under R2 -> Create bucket.
#   R2_PUBLIC_URL is that bucket's public URL (R2 -> bucket -> Settings ->
#   Public Access -> enable r2.dev subdomain, or connect a custom domain).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Shared secret that lets the Mirror Try-On app save pictures into the Try-On
# Gallery. Must be the same value as TRYON_SHARED_SECRET on Vercel (16+ chars).
#   python -c "import secrets; print(secrets.token_hex(32))"
# Leave unset to switch saving off.
TRYON_SHARED_SECRET=

# How many reverse proxies sit in front of the app. It is used to find the real client
# address for the login lockout, so someone cannot dodge the lockout by sending a fake
# X-Forwarded-For header. PythonAnywhere and a Cloudflare tunnel are both 1 (the default).
# Use 0 when people connect straight to the app on your own network, with nothing in front.
# TRUSTED_PROXY_COUNT=1

# Largest upload accepted, in MB (photos, invoice scans). Bigger requests are refused
# with a clear message. Default 25.
# MAX_UPLOAD_MB=25

# Passwords for the admin and staff accounts the app creates on its very first start.
# Set both BEFORE the first run. If you leave them blank, random passwords are generated
# and printed once in the console / server log. (Changing these later has no effect: the
# accounts already exist - use My Profile or Users -> change password instead.)
# INITIAL_ADMIN_PASSWORD=
# INITIAL_STAFF_PASSWORD=
